/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per-module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    withName: 'SETUP_REFERENCES' {
        cpus       = { 1 }
        memory     = { 4.GB }
        publishDir = [ enabled: false ]
    }

    withName: 'GET_REPEAT_REGIONS' {
        cpus       = { 1 }
        memory     = { 8.GB }
        publishDir = [ enabled: false ]
    }

    withName: 'GET_REFERENCE_REGIONS' {
        cpus       = { 1 }
        memory     = { 4.GB }
        publishDir = [ enabled: false ]
    }

    withName: 'GET_BREAKPOINTS' {
        cpus       = { 1 }
        memory     = { [ 16.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit ].min() }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/breakpoints" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GET_SEGMENTS' {
        cpus       = { 1 }
        memory     = { 8.GB }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/segments" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPLIT_BED' {
        cpus       = { 2 }
        memory     = { 8.GB }
        publishDir = [ enabled: false ]  // intermediate files
    }

    withName: 'COMPUTE_COVERAGE' {
        cpus       = { 2 }
        memory     = { [ 72.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit ].min() }
       publishDir = [
        path: { "${params.outdir}/${meta.id}/coverage_debug" },
        mode: params.publish_dir_mode,
        pattern: "*_has_normal_debug.txt"
        ]
    }

    withName: 'MERGE_COVERAGE' {
        cpus       = { 1 }
        memory     = { 16.GB }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/coverage" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DETECT_CYCLES' {
        cpus       = { 1 }
        memory     = { [ 32.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit ].min() }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DRAW_CYCLES' {
        cpus       = { 1 }
        memory     = { 16.GB }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
